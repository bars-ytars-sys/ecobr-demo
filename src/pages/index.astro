<script>
  const init = () => {
    // Видео первого экрана: только если можно (не экономия трафика, не «уменьшить движение»)
    const v = document.querySelector<HTMLVideoElement>('.hero-video');
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (v && !v.dataset['started'] && !conn?.saveData && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.dataset['started'] = '1';
      const mobile = matchMedia('(max-width: 640px)').matches;
      const sources = (mobile ? v.dataset['mobile'] : v.dataset['desktop'])?.split('|') ?? [];
      const start = () => {
        sources.forEach((src) => {
          const s = document.createElement('source');
          s.src = src;
          s.type = src.endsWith('.webm') ? 'video/webm' : 'video/mp4';
          v.append(s);
        });
        v.load();
        v.addEventListener('playing', () => v.classList.remove('opacity-0'), { once: true });
        v.play().catch(() => {});
      };
      if (document.readyState === 'complete') setTimeout(start, 600);
      else addEventListener('load', () => setTimeout(start, 600), { once: true });
    }
    const tabs = document.querySelectorAll<HTMLButtonElement>('.exp-tab');
    tabs.forEach((b) =>
      b.addEventListener('click', () => {
        tabs.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        document.querySelectorAll<HTMLElement>('.exp-panel').forEach((p) => (p.hidden = p.dataset['i'] !== b.dataset['i']));
      }),
    );
    document.querySelectorAll<HTMLButtonElement>('.copy-code').forEach((b) =>
      b.addEventListener('click', async () => {
        await navigator.clipboard?.writeText(b.dataset['code'] ?? '');
        const hint = b.querySelector('span');
        if (hint) hint.textContent = 'скопировано';
      }),
    );
  };
  document.addEventListener('astro:page-load', init);
</script>
