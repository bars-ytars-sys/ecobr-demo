<script>
  // Переключатели «типы домов» и «впечатления»: все панели уже в HTML, JS только показывает нужную
  const tabs = (tabSel: string, panelSel: string) => {
    const buttons = document.querySelectorAll<HTMLButtonElement>(tabSel);
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        document.querySelectorAll<HTMLElement>(panelSel).forEach((p) => (p.hidden = p.dataset['i'] !== b.dataset['i']));
      }),
    );
  };
  tabs('.type-tab', '.type-panel');
  tabs('.exp-tab', '.exp-panel');
  document.querySelectorAll<HTMLButtonElement>('.copy-code').forEach((b) =>
    b.addEventListener('click', async () => {
      await navigator.clipboard?.writeText(b.dataset['code'] ?? '');
      const hint = b.querySelector('span');
      if (hint) hint.textContent = 'скопировано';
    }),
  );
</script>

<style>
  .type-tab[aria-selected='true'] span {
    background: var(--color-mint);
  }
</style>
