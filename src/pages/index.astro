---
import { Picture, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HouseRail from '../components/HouseRail.astro';
import { link, site } from '../data/site';
import { faq } from '../data/faq';

import heroBarn from '../assets/site/hero-barn.jpg';
import heroPond from '../assets/site/hero-pond.jpg';
import heroBirch from '../assets/site/hero-birch.jpg';
import banya1 from '../assets/site/banya-1.jpg';
import banya2 from '../assets/site/banya-2.jpg';
import banya4 from '../assets/site/banya-4.jpg';
import chanOrange from '../assets/site/chan-orange.jpg';
import chanBirch from '../assets/site/chan-birch.jpg';
import food1 from '../assets/site/food-1.jpg';
import food2 from '../assets/site/food-2.jpg';
import food3 from '../assets/site/food-3.jpg';
import food4 from '../assets/site/food-4.jpg';
import spaPool from '../assets/site/spa-pool.jpg';
import spaSauna from '../assets/site/spa-sauna.jpg';
import horse from '../assets/site/horse.jpg';
import vipEvening from '../assets/site/vip-evening.jpg';
import vipBath from '../assets/site/vip-bath.jpg';

const houses = (await getCollection('houses')).sort((a, b) => a.data.order - b.data.order);
const og = await getImage({ src: heroBirch, width: 1200, format: 'jpg' });

const activities = [
  ['Конные прогулки', 'Живописные маршруты и тишина леса'],
  ['Рыбалка', 'Собственные пруды в 300 м от домов'],
  ['Сапборды', 'Прогулки по Истре'],
  ['Багги и квадроциклы', 'Когда хочется драйва'],
  ['Контактная ферма', 'Посещение бесплатное'],
  ['Флоатинг', 'Невесомость и глубокий покой'],
] as const;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Resort',
    '@id': `${site.url}/#organization`,
    name: site.legalName,
    url: `${site.url}/`,
    image: new URL(og.src, site.url).href,
    telephone: site.phone,
    priceRange: 'от 10 000 ₽ за сутки',
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'RU',
      addressRegion: 'Московская область',
      addressLocality: 'деревня Васюково',
      streetAddress: 'Солнечногорский район, КДЗ Новое Мишкино 1/5',
    },
    geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lon },
    hasMap: site.yandexMaps,
    petsAllowed: true,
    amenityFeature: ['SPA-комплекс', 'Банные чаны', 'Баня', 'Ресторан', 'Рыбалка', 'Контактная ферма', 'Парковка', 'Wi-Fi'].map((name) => ({
      '@type': 'LocationFeatureSpecification',
      name,
      value: true,
    })),
    containsPlace: houses.map((h) => ({ '@id': `${site.url}/doma/${h.id}#accommodation` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title="База отдыха с питанием и SPA в Подмосковье | Березовая роща"
  description="Забронируйте базу отдыха в Подмосковье с SPA, питанием и развлечениями. Недорогие цены, отзывы, фото. Бронирование онлайн."
  ogImage={og.src}
  jsonLd={jsonLd}
>
  {/* ПЕРВЫЙ ЭКРАН: один резкий кадр — А-фрейм в берёзах. Тёмный градиент только снизу, под текст */}
  <section class="relative isolate flex min-h-svh items-end overflow-hidden">
    <Picture
      formats={['avif', 'webp']}
      src={heroBirch}
      alt="А-фрейм среди берёз, к дому ведёт деревянная дорожка"
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_20%] sm:object-[50%_40%]"
    />
    <div class="absolute inset-x-0 top-0 -z-10 h-40 bg-gradient-to-b from-night/60 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-[85%] bg-gradient-to-t from-night via-night/75 to-transparent sm:h-[70%] sm:via-night/60"></div>

    <div class="wrap pb-20 sm:pb-14">
      <div class="grid gap-6 sm:gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="label text-cream/90 [text-shadow:0_1px_12px_rgb(0_0_0/60%)]">Экобаза в берёзовой роще · 40 минут от Москвы</p>
          {/* H1 сохранён дословно с текущего сайта — сигнал для Яндекса не меняем в день переезда */}
          <h1 class="mt-4 text-[2.15rem] leading-[1.02] sm:mt-5 sm:text-6xl lg:text-[4.2rem] xl:text-[4.6rem]">
            База отдыха «Берёзовая Роща» с&nbsp;питанием и&nbsp;SPA в&nbsp;Подмосковье
          </h1>
        </div>
        <div class="lg:col-span-4 lg:pb-2">
          <p class="hidden max-w-sm leading-relaxed text-cream/85 sm:block">22 дизайнерских дома, SPA-комплекс, баня, банные чаны и ресторан. От 10 000 ₽ в сутки.</p>
          <div class="grid grid-cols-2 gap-3 sm:mt-6 sm:flex sm:flex-wrap">
            <a href={site.booking} class="btn-brass px-3! tracking-[0.12em]! sm:px-7! sm:tracking-[0.18em]!">Даты и цены</a>
            <a href={link('/doma')} class="btn-line px-3! tracking-[0.12em]! sm:px-7! sm:tracking-[0.18em]!">Выбрать дом</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 01 — О МЕСТЕ */}
  <section class="wrap grid gap-12 py-20 sm:py-36 lg:grid-cols-12">
    <p class="label text-brass lg:col-span-3">01 — О месте</p>
    <div class="lg:col-span-9">
      <p class="font-display text-[1.75rem] leading-[1.2] sm:text-5xl lg:text-[3.6rem]">
        Берёзовая роща, пруды и&nbsp;двадцать два дома, у&nbsp;каждого&nbsp;— свой характер. Здесь легко разговаривать до&nbsp;ночи и&nbsp;<em class="text-brass">никуда не&nbsp;спешить</em>.
      </p>
      <dl class="mt-16 grid grid-cols-2 gap-y-10 border-t border-moss pt-10 md:grid-cols-4">
        {
          [
            ['40 мин', 'на машине от Москвы'],
            ['300 м', 'до SPA-комплекса и прудов'],
            ['5 лет', '«Хорошее место» по версии Яндекса'],
            ['2–10', 'гостей — от уединения до праздника'],
          ].map(([k, v]) => (
            <div class="pr-6">
              <dt class="font-display text-[2.5rem] leading-none text-brass sm:text-6xl">{k}</dt>
              <dd class="mt-2 max-w-[14rem] text-sm leading-relaxed text-stone">{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* 02 — ДОМА */}
  <section id="doma" class="pb-20 sm:pb-36">
    <div class="wrap mb-12 grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="label text-brass">02 — Дома</p>
        <h2 class="mt-6 text-[2.5rem] leading-[1.02] sm:text-6xl lg:text-7xl">Выберите свой формат&nbsp;уюта</h2>
      </div>
      <p class="max-w-md leading-relaxed text-stone lg:col-span-4 lg:col-start-9">
        Каждый дом создан отдельным дизайнером и&nbsp;как правило, стоит на&nbsp;своей огороженной территории. От зеркального дома для двоих до&nbsp;флагманской Панорамы на&nbsp;десять гостей.
      </p>
    </div>
    <HouseRail houses={houses} />
    <div class="wrap mt-10">
      <a href={link('/doma')} class="link-line label text-cream">Весь каталог →</a>
    </div>
  </section>

  {/* ФОТО-ПАУЗА */}
  <section class="relative isolate flex min-h-[70svh] items-center overflow-hidden sm:min-h-[85svh]">
    <Picture formats={['avif', 'webp']} src={heroBarn} alt="Барнхаус у пруда среди берёз" widths={[640, 1080, 1600, 2400]} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-night/45"></div>
    <div class="wrap text-center">
      <p class="label text-cream/80">Берёзовая роща</p>
      <p class="mx-auto mt-6 max-w-4xl font-display text-[2.7rem] leading-[1.05] sm:text-7xl lg:text-8xl"><em>«Ради нас берут выходной»</em></p>
      <p class="mt-8 text-cream/80">Хорошее место по версии Яндекса — пять лет подряд</p>
    </div>
  </section>

  {/* 03 — БАНЯ И ЧАН */}
  <section id="banya" class="wrap grid gap-14 py-20 sm:py-36 lg:grid-cols-12">
    <div class="lg:sticky lg:top-32 lg:col-span-4 lg:self-start">
      <p class="label text-brass">03 — Баня и чан</p>
      <h2 class="mt-6 text-[2.5rem] leading-[1.02] sm:text-6xl">Тепло, пар и&nbsp;еловые ветки</h2>
      <p class="mt-8 leading-relaxed text-stone">
        Банные чаны с&nbsp;разными наполнителями — еловые, цитрусовые, «Клеопатры», романтические. У&nbsp;некоторых домов своя баня с&nbsp;панорамным видом. Можно пригласить парильщика.
      </p>
      <dl class="mt-10 divide-y divide-moss border-y border-moss text-sm">
        <div class="flex justify-between py-4"><dt class="text-stone">Банный чан</dt><dd>от 5 500 ₽</dd></div>
        <div class="flex justify-between py-4"><dt class="text-stone">Баня, 4 часа</dt><dd>от 6 000 ₽</dd></div>
      </dl>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:col-span-7 lg:col-start-6">
      <Picture formats={['avif', 'webp']} src={chanOrange} alt="Банный чан с апельсинами и хвоей" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 55vw, 100vw" class="aspect-[16/10] w-full object-cover" pictureAttributes={{ class: 'col-span-2' }} />
      <Picture formats={['avif', 'webp']} src={banya1} alt="Парная с подсветкой" widths={[400, 700]} sizes="(min-width: 1024px) 27vw, 50vw" class="aspect-[4/5] w-full object-cover" />
      <Picture formats={['avif', 'webp']} src={chanBirch} alt="Банный чан у А-фрейма среди берёз" widths={[400, 700]} sizes="(min-width: 1024px) 27vw, 50vw" class="aspect-[4/5] w-full object-cover" pictureAttributes={{ class: 'block sm:translate-y-16' }} />
      <Picture formats={['avif', 'webp']} src={banya4} alt="Печь в бане" widths={[400, 700]} sizes="(min-width: 1024px) 27vw, 50vw" class="aspect-[4/5] w-full object-cover" />
      <Picture formats={['avif', 'webp']} src={banya2} alt="Полки в бане" widths={[400, 700]} sizes="(min-width: 1024px) 27vw, 50vw" class="aspect-[4/5] w-full object-cover" />
    </div>
  </section>

  {/* 04 — SPA: светлая секция для контраста */}
  <section id="spa" class="bg-birch text-ink">
    <div class="wrap grid gap-14 py-20 sm:py-36 lg:grid-cols-12 lg:items-center">
      <div class="relative lg:col-span-7">
        <Picture formats={['avif', 'webp']} src={spaPool} alt="Подогреваемый бассейн под открытым небом зимой" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 55vw, 100vw" class="aspect-[4/3] w-full object-cover" />
        <Picture formats={['avif', 'webp']} src={spaSauna} alt="Отдых в сауне SPA-комплекса" widths={[300, 500]} sizes="(min-width: 1024px) 22vw, 45vw" class="absolute right-3 -bottom-8 aspect-square w-[40%] object-cover ring-4 ring-birch sm:-right-8 sm:-bottom-10 sm:ring-8" />
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <p class="label text-bark">04 — SPA-комплекс</p>
        <h2 class="mt-6 text-[2.5rem] leading-[1.02] sm:text-6xl">Бассейн под открытым небом</h2>
        <p class="mt-8 leading-relaxed text-bark">
          Зимой вода 28–30&nbsp;°C. Турецкий хамам, русская баня на&nbsp;дровах, японская баня, массаж и&nbsp;уходовые процедуры.
        </p>
        <dl class="mt-10 divide-y divide-ink/15 border-y border-ink/15 text-sm">
          {
            [
              ['1 час', '1 000 ₽'],
              ['2 часа', '1 500 ₽'],
              ['Безлимит на день', '4 000 ₽'],
              ['Дети до 14 лет', '−50%'],
            ].map(([k, v]) => (
              <div class="flex justify-between py-4">
                <dt class="text-bark">{k}</dt>
                <dd class="font-semibold">{v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-5 text-xs text-bark">Вс–чт 10:00–22:00 · пт–сб 10:00–23:00</p>
      </div>
    </div>
  </section>

  {/* 05 — РЕСТОРАН */}
  <section id="restoran" class="py-20 sm:py-36">
    <div class="wrap grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6">
        <p class="label text-brass">05 — Ресторан</p>
        <h2 class="mt-6 text-[2.5rem] leading-[1.02] sm:text-6xl lg:text-7xl">Завтраки, ужины и&nbsp;долгие разговоры</h2>
      </div>
      <p class="max-w-md leading-relaxed text-stone lg:col-span-4 lg:col-start-9">
        Полноценная кухня: завтраки «шведский стол», комплексные обеды и&nbsp;ужины. Можно заказать праздник — день рождения, романтик, девичник.
      </p>
    </div>
    <div class="mt-14 grid grid-cols-2 gap-3 px-5 sm:gap-5 sm:px-10 lg:grid-cols-4">
      {
        [
          { src: food1, alt: 'Горячее блюдо из ресторана', cls: 'lg:mt-24' },
          { src: food2, alt: 'Подача блюда', cls: '' },
          { src: food3, alt: 'Карпаччо', cls: 'lg:mt-12' },
          { src: food4, alt: 'Кофе', cls: 'lg:mt-32' },
        ].map((f) => (
          <Picture formats={['avif', 'webp']} src={f.src} alt={f.alt} widths={[320, 520, 720]} sizes="(min-width: 1024px) 24vw, 48vw" class="aspect-[3/4] w-full object-cover" pictureAttributes={{ class: `block ${f.cls}` }} />
        ))
      }
    </div>
  </section>

  {/* 06 — ВПЕЧАТЛЕНИЯ */}
  <section class="border-t border-moss">
    <div class="wrap grid gap-14 py-20 sm:py-36 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <Picture formats={['avif', 'webp']} src={horse} alt="Конная прогулка по лесу" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[4/5] w-full object-cover" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="label text-brass">06 — Чем заняться</p>
        <h2 class="mt-6 text-[2.5rem] leading-[1.02] sm:text-6xl">Наполните отдых впечатлениями</h2>
        <ol class="mt-12 border-t border-moss">
          {
            activities.map(([t, d], i) => (
              <li class="grid grid-cols-[3rem_1fr] items-baseline gap-4 border-b border-moss py-6 sm:grid-cols-[4rem_1fr_1fr]">
                <span class="label text-stone">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-display text-3xl">{t}</span>
                <span class="col-start-2 text-sm text-stone sm:col-start-3">{d}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* 07 — VIP */}
  <section id="vip" class="bg-forest py-20 sm:py-36">
    <div class="wrap">
      <p class="label text-brass">07 — VIP-программы</p>
      <h2 class="mt-6 max-w-3xl text-[2.5rem] leading-[1.02] sm:text-6xl lg:text-7xl">Когда хочется, чтобы всё&nbsp;сделали за&nbsp;вас</h2>
      <div class="mt-16 grid gap-10 md:grid-cols-2 md:gap-6">
        {
          [
            { t: 'Свидание года', d: 'Проживание, банный чан, массаж и фотосессия. Для свиданий, годовщин и романтических выходных.', img: vipEvening, alt: 'Пара у банного чана вечером' },
            { t: 'Полная перезагрузка', d: 'Баня с церемонией парения, массаж, прогулки, ресторан и SPA для перезагрузки тела и эмоций.', img: vipBath, alt: 'Ванна у панорамного окна' },
          ].map((v, i) => (
            <a href={link('/vip-programmy')} class:list={['group block', i === 1 && 'md:mt-24']}>
              <div class="overflow-hidden">
                <Picture formats={['avif', 'webp']} src={v.img} alt={v.alt} widths={[480, 800, 1100]} sizes="(min-width: 768px) 45vw, 100vw" class="aspect-[4/5] w-full object-cover transition duration-[1400ms] ease-[var(--ease-soft)] group-hover:scale-[1.04]" />
              </div>
              <h3 class="mt-7 text-4xl sm:text-5xl">{v.t}</h3>
              <p class="mt-3 max-w-md leading-relaxed text-stone">{v.d}</p>
              <span class="link-line label mt-6 inline-block">Подробнее →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section id="faq" class="wrap grid gap-14 py-20 sm:py-36 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="label text-brass">08 — Перед поездкой</p>
      <h2 class="mt-6 text-[2.5rem] leading-[1.02] sm:text-6xl">Частые вопросы</h2>
      <p class="mt-8 text-stone">Не нашли ответ? <a class="link-line text-cream" href={site.phoneHref}>{site.phone}</a></p>
    </div>
    <div class="border-t border-moss lg:col-span-7 lg:col-start-6">
      {
        faq.map((f) => (
          <details class="group border-b border-moss">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-8 py-6 font-display text-2xl sm:text-[1.7rem]">
              {f.q}
              <span class="shrink-0 font-sans text-xl text-brass transition duration-500 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-2xl pb-7 leading-relaxed whitespace-pre-line text-stone">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  {/* ФИНАЛ */}
  <section class="relative isolate flex min-h-[90svh] items-end overflow-hidden">
    <Picture formats={['avif', 'webp']} src={heroPond} alt="А-фрейм у пруда в берёзовой роще" widths={[640, 1080, 1600, 2400]} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-night via-night/40 to-night/20"></div>
    <div class="wrap pb-24 sm:pb-28">
      <p class="font-display text-xl text-cream/80 italic sm:text-2xl">иногда достаточно одного решения, чтобы всё внутри стало тише</p>
      <h2 class="mt-4 max-w-5xl text-[2.7rem] leading-[1] sm:text-7xl lg:text-8xl">Ваш идеальный отдых начинается здесь</h2>
      <div class="mt-10 grid gap-3 sm:mt-12 sm:flex sm:flex-wrap sm:gap-4">
        <a href={site.booking} class="btn-brass">Проверить даты</a>
        <a href={site.phoneHref} class="btn-line">{site.phone}</a>
      </div>
    </div>
  </section>
</Base>
