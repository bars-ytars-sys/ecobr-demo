---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HouseCard from '../../components/HouseCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site } from '../../data/site';
import cover from '../../assets/houses/aframe-luxe-black/aframe-luxe-black-01.jpg';

const houses = (await getCollection('houses')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [
  { href: '/', label: 'Главная' },
  { href: '/doma', label: 'Каталог домов' },
];
// Группы под кластеры запросов: «дом для двоих», «для семьи», «для компании»
const groups = [
  { id: 'pair', title: 'Дома для двоих', note: 'Для романтических выходных, свиданий и тишины' },
  { id: 'family', title: 'Дома для семейного отдыха', note: 'Отдельные спальни и простор для отдыха с детьми' },
  { id: 'company', title: 'Дома для компании', note: 'Большие дома для праздников и встреч с друзьями' },
] as const;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Каталог домов базы отдыха «Берёзовая роща»',
    numberOfItems: houses.length,
    itemListElement: houses.map((h, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/doma/${h.id}`, name: h.data.name })),
  },
];
---

<Base
  title="Каталог домов для отдыха в Берёзовой роще"
  description="Дома базы отдыха «Берёзовая роща»: А-фреймы, барнхаусы, шале, Сфера и Панорама с банным чаном и баней, от 2 до 10 гостей. Цены и фото."
  jsonLd={jsonLd}
>
  <section data-hero-dark>
    <div class="relative isolate overflow-hidden px-4 pt-32 pb-24 text-white sm:px-8 sm:pt-40 sm:pb-32 lg:px-[max(2rem,calc((100vw-1240px)/2+2rem))]">
      <Picture formats={['avif', 'webp']} src={cover} alt="" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/75 via-black/45 to-black/10"></div>
      <div class="[&_a]:text-white/80 [&_span]:text-white"><Breadcrumbs items={crumbs} /></div>
      <h1 class="mt-6 max-w-3xl text-[2rem] leading-[1.02] sm:mt-8 sm:text-6xl lg:text-7xl" data-reveal>Каталог домов для разных сценариев отдыха</h1>
      <p class="mt-4 max-w-xl text-white/85" data-reveal>Каждый домик — уникальный проект со стильным дизайном и собственной территорией. У одних домов есть банные чаны, у других — бани.</p>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Разделы каталога" data-reveal>
        {groups.map((g) => <a href={`#${g.id}`} class="glass-dark rounded-full px-4 py-2.5 font-display text-xs uppercase hover:bg-white hover:text-ink">{g.title}</a>)}
      </nav>
      <svg class="absolute inset-x-0 -bottom-px h-12 w-full text-page sm:h-20" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 C240 10 480 10 720 45 C960 80 1200 90 1440 40 L1440 100 L0 100 Z" fill="currentColor" /></svg>
    </div>
  </section>

  {
    groups.map((g) => (
      <section id={g.id} class="wrap scroll-mt-24 py-10 sm:py-14" aria-labelledby={`${g.id}-title`}>
        <p class="eyebrow" data-reveal>{g.note}</p>
        <h2 id={`${g.id}-title`} class="h-section mt-3" data-reveal>{g.title}</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {houses.filter((h) => h.data.scenarios.includes(g.id)).map((h, i) => <HouseCard house={h} delay={i} />)}
        </div>
      </section>
    ))
  }

  <LeadForm />
</Base>
