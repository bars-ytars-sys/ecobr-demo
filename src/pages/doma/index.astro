---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HouseCard from '../../components/HouseCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';

const houses = (await getCollection('houses')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [
  { href: '/', label: 'Главная' },
  { href: '/doma', label: 'Дома' },
];
const groups = [
  { id: 'pair', title: 'Вдвоём', note: 'Для романтических выходных и тишины' },
  { id: 'family', title: 'Семьёй', note: 'Отдельные спальни и простор для семейного отдыха' },
  { id: 'company', title: 'Компанией', note: 'Большие дома для праздников и встреч' },
] as const;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Дома Берёзовой рощи',
    itemListElement: houses.map((h, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/doma/${h.id}`, name: h.data.name })),
  },
];
---

<Base
  title="Каталог домов для отдыха в Берёзовой роще"
  description="Дизайнерские дома в Берёзовой роще: А-фреймы, барнхаусы, шале, Сфера и Панорама. С банным чаном и баней, от 2 до 10 гостей. Цены и фото."
  jsonLd={jsonLd}
>
  <section class="wrap pt-28 pb-12 sm:pt-44 sm:pb-16">
    <Breadcrumbs items={crumbs} />
    <div class="mt-12 grid gap-8 lg:grid-cols-12 lg:items-end">
      <h1 class="text-[3.6rem] leading-[0.9] sm:text-8xl lg:col-span-7 lg:text-[9rem]">Дома</h1>
      <p class="max-w-md leading-relaxed text-stone lg:col-span-4 lg:col-start-9">
        Каталог домов для разных сценариев отдыха. В демо — 12 домов на фото и ценах с текущего сайта, остальные добавляются карточкой в CMS.
      </p>
    </div>
  </section>

  {
    groups.map((g, gi) => (
      <section class="wrap border-t border-moss py-16 sm:py-24">
        <div class="mb-12 grid gap-4 lg:grid-cols-12">
          <p class="label text-brass lg:col-span-3">{String(gi + 1).padStart(2, '0')}</p>
          <div class="lg:col-span-9">
            <h2 class="text-[2.5rem] leading-[1.02] sm:text-6xl">{g.title}</h2>
            <p class="mt-3 text-stone">{g.note}</p>
          </div>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {houses.filter((h) => h.data.scenarios.includes(g.id)).map((h) => <HouseCard house={h} />)}
        </div>
      </section>
    ))
  }
</Base>
