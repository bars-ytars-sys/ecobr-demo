---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HouseCard from '../../components/HouseCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Branch from '../../components/Branch.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site } from '../../data/site';

const houses = (await getCollection('houses')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [
  { href: '/', label: 'Главная' },
  { href: '/doma', label: 'Каталог домов' },
];
// Группы под кластеры запросов: «дом для двоих», «для семьи», «для компании»
const groups = [
  { id: 'pair', title: 'Дома для двоих', note: 'Для романтических выходных, свиданий и тишины' },
  { id: 'family', title: 'Дома для семейного отдыха', note: 'Отдельные спальни и простор для отдыха с детьми' },
  { id: 'company', title: 'Дома для компании', note: 'Большие дома для праздников и встреч с друзьями' },
] as const;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Каталог домов базы отдыха «Берёзовая роща»',
    numberOfItems: houses.length,
    itemListElement: houses.map((h, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/doma/${h.id}`, name: h.data.name })),
  },
];
---

<Base
  title="Каталог домов для отдыха в Берёзовой роще"
  description="Дома базы отдыха «Берёзовая роща»: А-фреймы, барнхаусы, шале, Сфера и Панорама с банным чаном и баней, от 2 до 10 гостей. Цены и фото."
  jsonLd={jsonLd}
>
  <section class="wrap pt-6 pb-4">
    <Breadcrumbs items={crumbs} />
    <h1 class="h-section mt-8">Каталог домов для разных <br class="hidden sm:block" />сценариев отдыха</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Каждый домик на базе отдыха «Берёзовая роща» — уникальный проект со стильным дизайном и собственной территорией. У одних домов есть банные чаны, у других — бани для полного релакса.
    </p>
    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Разделы каталога">
      {groups.map((g) => <a href={`#${g.id}`} class="chip hover:bg-mint-soft">{g.title}</a>)}
    </nav>
    <Branch class="mt-8" />
  </section>

  {
    groups.map((g) => (
      <section id={g.id} class="wrap scroll-mt-24 py-8" aria-labelledby={`${g.id}-title`}>
        <h2 id={`${g.id}-title`} class="font-display text-2xl uppercase sm:text-3xl">{g.title}</h2>
        <p class="mt-2 text-muted">{g.note}</p>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {houses.filter((h) => h.data.scenarios.includes(g.id)).map((h) => <HouseCard house={h} />)}
        </div>
      </section>
    ))
  }

  <LeadForm />
</Base>
