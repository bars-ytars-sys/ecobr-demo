---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Gallery from '../../components/Gallery.astro';
import HouseCard from '../../components/HouseCard.astro';
import Faq from '../../components/Faq.astro';
import LeadForm from '../../components/LeadForm.astro';
import { faq } from '../../data/faq';
import { site, rub } from '../../data/site';

export const getStaticPaths = (async () => {
  const houses = await getCollection('houses');
  return houses.map((house) => ({ params: { slug: house.id }, props: { house, all: houses } }));
}) satisfies GetStaticPaths;

interface Props {
  house: CollectionEntry<'houses'>;
  all: CollectionEntry<'houses'>[];
}
const { house, all } = Astro.props;
const h = house.data;
const url = `${site.url}/doma/${house.id}`;
const og = await getImage({ src: h.cover, width: 1200, format: 'jpg' });

// Перелинковка: похожие по сценарию отдыха и вместимости
const similar = all
  .filter((x) => x.id !== house.id)
  .sort((a, b) => {
    const sa = a.data.scenarios.some((s) => h.scenarios.includes(s)) ? 0 : 1;
    const sb = b.data.scenarios.some((s) => h.scenarios.includes(s)) ? 0 : 1;
    return sa - sb || Math.abs(a.data.capacity - h.capacity) - Math.abs(b.data.capacity - h.capacity);
  })
  .slice(0, 3);

const crumbs = [
  { href: '/', label: 'Главная' },
  { href: '/doma', label: 'Каталог домов' },
  { href: `/doma/${house.id}`, label: h.name },
];

const features = [h.banya && 'Баня', h.chan && 'Банный чан', `До ${h.capacity} гостей`].filter((x): x is string => Boolean(x));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Accommodation',
    '@id': `${url}#accommodation`,
    name: `${h.name} — Берёзовая роща`,
    description: h.lead,
    url,
    image: new URL(og.src, site.url).href,
    occupancy: { '@type': 'QuantitativeValue', minValue: 1, maxValue: h.capacity },
    petsAllowed: true,
    amenityFeature: features.slice(0, -1).map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
    containedInPlace: { '@id': `${site.url}/#organization` },
    offers: [
      { '@type': 'Offer', name: 'Будние дни (заезд с воскресенья по четверг)', price: h.price.weekday, priceCurrency: 'RUB', url, availability: 'https://schema.org/InStock', businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut' },
      { '@type': 'Offer', name: 'Выходные дни (заезд в пятницу и субботу от 2 ночей)', price: h.price.weekend, priceCurrency: 'RUB', url, availability: 'https://schema.org/InStock', businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={h.title} description={h.description} ogImage={og.src} jsonLd={jsonLd}>
  <div class="wrap pt-6">
    <Breadcrumbs items={crumbs} />
  </div>

  {/* Карточка дома — композиция текущего сайта */}
  <section class="wrap pt-6">
    <div class="card relative grid gap-8 overflow-hidden p-5 sm:p-8 lg:grid-cols-[1.4fr_0.9fr_0.8fr] lg:items-center">
      <div class="pointer-events-none absolute -top-24 -left-24 size-80 rounded-full bg-mint/20 blur-3xl"></div>
      <div class="relative">
        <p class="mark w-fit text-xs font-semibold">{h.tagline}</p>
        <h1 class="mt-4 text-4xl sm:text-5xl">{h.name}</h1>
        <p class="mt-4 max-w-lg text-[0.95rem] leading-relaxed">{h.lead}</p>
      </div>
      <div class="relative">
        <ul class="space-y-3">
          {
            features.map((f) => (
              <li class="flex items-center gap-3 text-sm">
                <span class="grid size-8 place-items-center rounded-full bg-mint-soft text-mint-dark" aria-hidden="true">✓</span>
                {f}
              </li>
            ))
          }
        </ul>
        <a href={site.booking} class="btn-mint mt-5 w-full sm:w-auto">Проверить даты</a>
      </div>
      <Picture formats={['avif', 'webp']} src={h.gallery[1] ?? h.cover} alt={`${h.name}: интерьер`} widths={[320, 480]} sizes="(min-width: 1024px) 260px, 90vw" class="relative hidden aspect-[4/3] w-full rounded-[14px] object-cover lg:block" />
    </div>
  </section>

  <section class="wrap pt-10" aria-labelledby="photos-title">
    <h2 id="photos-title" class="border-b-2 border-mint pb-3 font-display text-sm uppercase">Фото дома «{h.name}»</h2>
    <div class="mt-6">
      <Gallery images={h.gallery} name={h.name} />
    </div>
  </section>

  {/* Цены — карточки будни/выходные с выделением, как на сайте */}
  <section class="wrap py-12" aria-labelledby="price-title">
    <h2 id="price-title" class="sr-only">Стоимость проживания в доме «{h.name}»</h2>
    <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-start">
      <div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="card p-5">
            <p class="font-display text-lg uppercase">Будние дни</p>
            <p class="text-sm text-muted">(заезд <b class="text-ink">с воскресенья по четверг</b>)</p>
            <p class="mt-3 font-display text-2xl">от <span class="mark">{rub(h.price.weekday)}</span> <span class="font-sans text-xs text-muted">/сутки*</span></p>
          </div>
          <div class="card p-5">
            <p class="font-display text-lg uppercase">Выходные дни</p>
            <p class="text-sm text-muted">(заезд <b class="text-ink">в пятницу и субботу</b> от 2 ночей)</p>
            <p class="mt-3 font-display text-2xl">от <span class="mark">{rub(h.price.weekend)}</span> <span class="font-sans text-xs text-muted">/сутки*</span></p>
          </div>
        </div>
        <a href="#lead" class="btn-outline mt-4 w-full">Заказать звонок</a>
      </div>
      <div class="space-y-3 text-sm">
        {h.priceNotes.map((n) => <p>{n}</p>)}
        <p>Комфортное размещение <b>до {h.capacity} человек</b></p>
        <p class="text-muted">Отдел продаж работает ежедневно с 9:00 до 24:00. Если вы оставляете заявку в нерабочее время, вы можете самостоятельно <a class="text-mint-dark underline" href={site.booking}>забронировать дом здесь</a>.</p>
      </div>
    </div>
  </section>

  <section class="wrap pb-6" aria-labelledby="similar-title">
    <h2 id="similar-title" class="h-section">Похожие дома</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {similar.map((s) => <HouseCard house={s} />)}
    </div>
  </section>

  <Faq />
  <LeadForm />
</Base>
