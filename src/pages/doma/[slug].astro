---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Gallery from '../../components/Gallery.astro';
import HouseCard from '../../components/HouseCard.astro';
import Faq from '../../components/Faq.astro';
import LeadForm from '../../components/LeadForm.astro';
import { faq } from '../../data/faq';
import { site, rub } from '../../data/site';

export const getStaticPaths = (async () => {
  const houses = await getCollection('houses');
  return houses.map((house) => ({ params: { slug: house.id }, props: { house, all: houses } }));
}) satisfies GetStaticPaths;

interface Props {
  house: CollectionEntry<'houses'>;
  all: CollectionEntry<'houses'>[];
}
const { house, all } = Astro.props;
const h = house.data;
const url = `${site.url}/doma/${house.id}`;
const og = await getImage({ src: h.cover, width: 1200, format: 'jpg' });

// Перелинковка: похожие по сценарию отдыха и вместимости
const similar = all
  .filter((x) => x.id !== house.id)
  .sort((a, b) => {
    const sa = a.data.scenarios.some((s) => h.scenarios.includes(s)) ? 0 : 1;
    const sb = b.data.scenarios.some((s) => h.scenarios.includes(s)) ? 0 : 1;
    return sa - sb || Math.abs(a.data.capacity - h.capacity) - Math.abs(b.data.capacity - h.capacity);
  })
  .slice(0, 3);

const crumbs = [
  { href: '/', label: 'Главная' },
  { href: '/doma', label: 'Каталог домов' },
  { href: `/doma/${house.id}`, label: h.name },
];
const facts = [
  { k: 'Гостей', v: `до ${h.capacity}` },
  { k: 'Банный чан', v: h.chan ? 'есть' : '—' },
  { k: 'Баня', v: h.banya ? 'своя' : 'в SPA, 300 м' },
  { k: 'Кадров', v: String(h.gallery.length) },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Accommodation',
    '@id': `${url}#accommodation`,
    name: `${h.name} — Берёзовая роща`,
    description: h.lead,
    url,
    image: new URL(og.src, site.url).href,
    occupancy: { '@type': 'QuantitativeValue', minValue: 1, maxValue: h.capacity },
    petsAllowed: true,
    amenityFeature: [h.chan && 'Банный чан', h.banya && 'Собственная баня']
      .filter((x): x is string => Boolean(x))
      .map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
    containedInPlace: { '@id': `${site.url}/#organization` },
    offers: [
      { '@type': 'Offer', name: 'Будние дни (заезд с воскресенья по четверг)', price: h.price.weekday, priceCurrency: 'RUB', url, availability: 'https://schema.org/InStock' },
      { '@type': 'Offer', name: 'Выходные дни (заезд в пятницу и субботу от 2 ночей)', price: h.price.weekend, priceCurrency: 'RUB', url, availability: 'https://schema.org/InStock' },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Base title={h.title} description={h.description} ogImage={og.src} jsonLd={jsonLd}>
  {/* Первый экран дома: обложка во всю ширину, волна снизу, карточка цены */}
  <section data-hero-dark>
    <div class="relative isolate flex min-h-[86svh] flex-col justify-end overflow-hidden text-white lg:min-h-[700px]">
      <Picture
        formats={['avif', 'webp']}
        src={h.cover}
        alt={`${h.name} в Берёзовой роще`}
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        transition:name={`cover-${house.id}`}
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/20 to-black/40"></div>
      <div class="wrap grid gap-6 pt-28 pb-20 sm:pb-24 lg:grid-cols-[1.5fr_1fr] lg:items-end">
        <div>
          <div class="[&_a]:text-white/80 [&_span]:text-white"><Breadcrumbs items={crumbs} /></div>
          <p class="glass-dark mt-6 inline-flex rounded-full px-4 py-2 text-xs font-semibold" data-reveal>{h.tagline}</p>
          <h1 class="mt-4 text-[2.8rem] leading-[0.95] sm:text-7xl lg:text-[5.5rem]" data-reveal style="--d:1">{h.name}</h1>
          <dl class="mt-6 grid max-w-2xl grid-cols-4 border-y border-white/25 py-3" data-reveal style="--d:2">
            {facts.map((f) => <div class="px-1 sm:px-3"><dt class="text-[0.6rem] text-white/60 uppercase sm:text-xs">{f.k}</dt><dd class="font-display text-sm sm:text-xl">{f.v}</dd></div>)}
          </dl>
        </div>
        <div class="card p-5 text-ink sm:p-6 lg:justify-self-end" data-reveal style="--d:3">
          <div class="grid grid-cols-2 gap-4">
            <div><p class="text-xs text-muted">Будни, вс–чт</p><p class="font-display text-2xl">{rub(h.price.weekday)}</p></div>
            <div><p class="text-xs text-muted">Выходные, от 2 ночей</p><p class="font-display text-2xl">{rub(h.price.weekend)}</p></div>
          </div>
          <a href={site.booking} class="btn-mint mt-4 w-full">Проверить даты</a>
          <p class="mt-2 text-center text-xs text-muted">Цена за сутки при двухместном размещении</p>
        </div>
      </div>
          <svg class="absolute inset-x-0 -bottom-px h-12 w-full text-page sm:h-20" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 C240 10 480 10 720 45 C960 80 1200 90 1440 40 L1440 100 L0 100 Z" fill="currentColor" /></svg>
    </div>
  </section>

  <section class="wrap py-12 sm:py-16" aria-labelledby="about-title">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr]">
      <div data-reveal>
        <p class="eyebrow">О доме</p>
        <h2 id="about-title" class="h-section mt-3">Дом «{h.name}»</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed">{h.lead}</p>
        <p class="mt-4 max-w-2xl text-muted">Рядом — SPA-комплекс с бассейном под открытым небом, ресторан, контактная ферма и рыбалка на собственных прудах. С животными можно.</p>
      </div>
      <div class="card p-6 text-sm" data-reveal style="--d:1">
        <p class="font-display uppercase">Условия</p>
        <ul class="mt-4 space-y-2.5">
          {h.priceNotes.map((n) => <li class="flex gap-2"><span class="dot mt-2 shrink-0 text-mint" />{n.replace(/^\*/, '')}</li>)}
          <li class="flex gap-2"><span class="dot mt-2 shrink-0 text-mint" />Комфортное размещение до {h.capacity} человек</li>
          <li class="flex gap-2"><span class="dot mt-2 shrink-0 text-mint" />Отдел продаж работает ежедневно с 9:00 до 24:00</li>
        </ul>
        <a href="#lead" class="btn-dark mt-6 w-full">Заказать звонок</a>
      </div>
    </div>
  </section>

  <section class="wrap pb-12 sm:pb-16" aria-labelledby="photos-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="photos-title" class="h-section" data-reveal>Фотографии</h2>
      <p class="eyebrow" data-reveal>{h.gallery.length} кадров</p>
    </div>
    <div class="mt-6"><Gallery images={h.gallery} name={h.name} /></div>
  </section>

  <section class="wrap pb-6" aria-labelledby="similar-title">
    <p class="eyebrow" data-reveal>Если хочется сравнить</p>
    <h2 id="similar-title" class="h-section mt-3" data-reveal>Похожие дома</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {similar.map((s, i) => <HouseCard house={s} delay={i} />)}
    </div>
  </section>

  <Faq />
  <LeadForm />
</Base>
