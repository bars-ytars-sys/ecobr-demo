---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { link, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, ogImage, jsonLd = [] } = Astro.props;
// canonical всегда на боевой домен, без подпапки демо
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length).replace(/\/$/, '');
const canonical = new URL(path || '/', site.url).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Демо: закрыто от индексации. На проде убрать */}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f4ede2" />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, site.url).href} />}
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={link('/sitemap.xml')} />
    <Font cssVariable="--font-despair" preload />
    <Font cssVariable="--font-manrope" preload={[{ subset: 'cyrillic', weight: '400', style: 'normal' }]} />
    {jsonLd.map((ld) => <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {/* Плавные переходы между страницами (View Transitions) */}
    <ClientRouter fallback="swap" />
    {/* Яндекс.Метрика: тот же счётчик, что на Тильде, подключается напрямую (не Partytown — ломает вебвизор и цели) */}
  </head>
  <body class="min-h-dvh pb-[calc(4.5rem+env(safe-area-inset-bottom))] sm:pb-0">
    <a href="#main" class="btn-mint sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70]">К содержанию</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Мобильный: бронь всегда под пальцем, как на открытьбазу.рф */}
    <div class="mobile-cta fixed inset-x-0 bottom-0 z-50 translate-y-full p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] transition-transform duration-500 sm:hidden" transition:persist>
      <div class="glass flex gap-2 rounded-full p-1.5 shadow-lg">
        <a href={site.phoneHref} class="grid size-12 shrink-0 place-items-center rounded-full bg-white text-ink" aria-label="Позвонить">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
        </a>
        <a href={site.booking} class="btn-mint flex-1 px-3! py-3.5!">Проверить даты и цены</a>
      </div>
    </div>

    <script>
      // Появление блоков при прокрутке + счётчики цифр; перезапуск после переходов View Transitions
      const run = () => {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              const el = e.target as HTMLElement;
              el.classList.add('is-in');
              el.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => {
                const to = Number(n.dataset['count']);
                const t0 = performance.now();
                const tick = (t: number) => {
                  const k = Math.min(1, (t - t0) / 1400);
                  n.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
                  if (k < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
              });
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        document.querySelectorAll('[data-reveal]:not(.is-in)').forEach((el) => io.observe(el));
      };
      document.addEventListener('astro:page-load', run);
      // Липкая кнопка брони на телефоне появляется после первого экрана, чтобы не перекрывать форму в нём
      const bar = document.querySelector<HTMLElement>('.mobile-cta');
      const onScroll = () => bar?.classList.toggle('translate-y-full', window.scrollY < window.innerHeight * 0.7);
      addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('astro:page-load', onScroll);
    </script>
  </body>
</html>
