---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { link, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, ogImage, jsonLd = [] } = Astro.props;
// canonical всегда на боевой домен, без подпапки демо
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length).replace(/\/$/, '');
const canonical = new URL(path || '/', site.url).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Демо: закрыто от индексации. На проде убрать */}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f4f6fb" />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, site.url).href} />}
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={link('/sitemap.xml')} />
    <Font cssVariable="--font-despair" preload />
    <Font cssVariable="--font-manrope" preload={[{ subset: 'cyrillic', weight: '400', style: 'normal' }]} />
    {jsonLd.map((ld) => <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />)}
    {/* Яндекс.Метрика: тот же счётчик, что на Тильде, подключается напрямую (не Partytown — ломает вебвизор и цели) */}
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="btn-mint sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70]">К содержанию</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <a
      href={site.telegram}
      target="_blank"
      rel="noopener"
      aria-label="Написать в Telegram"
      class="fixed right-4 bottom-4 z-40 grid size-14 place-items-center rounded-full bg-mint text-[#0b3b2c] shadow-[0_10px_30px_-8px_rgb(46_216_163/0.9)] transition hover:scale-105"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="M8 10h.01M12 10h.01M16 10h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
    </a>
  </body>
</html>
