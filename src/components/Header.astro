---
import logo from '../assets/v2/brand/brand-02.svg';
import { link, nav, site } from '../data/site';
---

<header class="sticky top-0 z-50 bg-white/95 shadow-[0_1px_0_rgb(0_0_0/0.05)] backdrop-blur">
  <div class="wrap flex h-16 items-center justify-between gap-3 lg:h-[72px]">
    <a href={link('/')} class="shrink-0" aria-label="Берёзовая роща — главная">
      <img src={logo.src} width="120" height="44" alt="Берёзовая роща" class="h-9 w-auto lg:h-11" />
    </a>

    <div class="ml-auto flex items-center gap-3 lg:gap-4">
      <div class="text-right leading-tight">
        <p class="hidden text-[0.7rem] text-muted sm:block">Отдел бронирования работает с 9:00 до 24:00</p>
        <a href={site.phoneHref} class="font-display text-[0.8rem] sm:text-base">{site.phone}</a>
      </div>
      <a href={`${link('/')}#lead`} class="btn-outline hidden px-4! py-3! md:inline-flex">Обратный звонок</a>
      <a href={site.booking} class="btn-mint hidden px-4! py-3! lg:inline-flex">Проверить даты и забронировать</a>
      <details class="menu relative">
        <summary class="btn-outline cursor-pointer list-none rounded-full! px-4! py-2.5!">Меню</summary>
        <nav aria-label="Основное меню" class="card absolute right-0 mt-3 w-72 p-6">
          <ul class="space-y-3 font-display text-sm uppercase">
            {nav.map((i) => <li><a class="hover:text-mint-dark" href={link(i.href)}>{i.label}</a></li>)}
          </ul>
          <a href={site.booking} class="btn-mint mt-6 w-full lg:hidden">Проверить даты</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Меню закрывается по клику вне и по Esc
  const menu = document.querySelector<HTMLDetailsElement>('details.menu');
  document.addEventListener('click', (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu) menu.open = false;
  });
</script>
