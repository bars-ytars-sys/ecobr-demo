---
import { link, nav, site } from '../data/site';
---

{/* Прозрачная шапка поверх фото; при прокрутке — тёмная подложка */}
<header class="site-header fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter] duration-500">
  <div class="wrap flex h-18 items-center justify-between gap-6 lg:h-22">
    <a href={link('/')} class="flex flex-col leading-none">
      <span class="font-display text-[1.5rem] tracking-tight sm:text-[1.65rem] xl:text-[1.9rem]">Берёзовая роща</span>
      <span class="label mt-1 text-[0.55rem] text-cream/60">экобаза · подмосковье</span>
    </a>

    <nav aria-label="Основное меню" class="hidden lg:block">
      <ul class="flex items-center gap-5 text-[0.78rem] tracking-wide xl:gap-9">
        {nav.map((i) => <li><a class="link-line text-cream/80 hover:text-cream" href={link(i.href)}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-6">
      <a href={site.phoneHref} class="hidden text-sm tracking-wide md:inline lg:hidden xl:inline">{site.phone}</a>
      <a href={site.booking} class="btn-brass hidden px-5! py-3! sm:inline-flex">Забронировать</a>
      <details class="relative lg:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center ring-1 ring-cream/30" aria-label="Меню">
          <svg width="20" height="10" viewBox="0 0 20 10" fill="none" aria-hidden="true"><path d="M0 1h20M0 9h20" stroke="currentColor" stroke-width="1.2" /></svg>
        </summary>
        <div class="absolute right-0 mt-3 w-72 bg-forest p-7 shadow-2xl ring-1 ring-moss">
          <ul class="space-y-4 font-display text-2xl">
            {nav.map((i) => <li><a href={link(i.href)}>{i.label}</a></li>)}
          </ul>
          <a href={site.phoneHref} class="mt-7 block text-lg">{site.phone}</a>
          <p class="mt-1 text-xs text-stone">{site.hours}</p>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const h = document.querySelector<HTMLElement>('.site-header');
  if (h) {
    const on = () => {
      const s = window.scrollY > 60;
      h.classList.toggle('bg-night/85', s);
      h.classList.toggle('backdrop-blur-md', s);
    };
    on();
    window.addEventListener('scroll', on, { passive: true });
  }
</script>
