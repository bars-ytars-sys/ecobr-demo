---
import logo from '../assets/v2/brand/brand-02.svg';
import logoWhite from '../assets/v2/brand/brand-01.svg';
import { link, nav, site } from '../data/site';

// Шапка поверх фото: прозрачная с белым текстом, при прокрутке — белая
const quick = [
  { href: '/doma', label: 'Дома' },
  { href: '/special', label: 'Акции' },
  { href: '/spa', label: 'SPA' },
  { href: '/banchan', label: 'Бани и чаны' },
  { href: '/contacts', label: 'Контакты' },
];
---

<header class="site-header fixed inset-x-0 top-0 z-50 text-white transition-[background-color,color,box-shadow] duration-500" data-top transition:persist>
  <div class="mx-auto flex h-16 max-w-[1400px] items-center gap-6 px-4 sm:h-20 sm:px-8">
    <a href={link('/')} class="relative shrink-0" aria-label="Берёзовая роща — главная">
      <img src={logoWhite.src} width="120" height="44" alt="Берёзовая роща" class="logo-white h-9 w-auto sm:h-11" />
      <img src={logo.src} width="120" height="44" alt="" class="logo-dark absolute inset-0 h-9 w-auto opacity-0 sm:h-11" />
    </a>

    <nav aria-label="Быстрые разделы" class="ml-6 hidden lg:block">
      <ul class="flex items-center gap-7 text-[0.92rem] font-medium">
        {quick.map((i) => <li><a class="opacity-90 transition hover:opacity-100 hover:text-mint" href={link(i.href)}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-3 sm:gap-5">
      <a href={site.phoneHref} class="hidden font-semibold whitespace-nowrap md:inline">{site.phone}</a>
      <a href={site.booking} class="btn-mint hidden px-5! py-3! sm:inline-flex">Забронировать</a>
      <details class="menu relative">
        <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-full bg-white/15 ring-1 ring-current/30 backdrop-blur transition hover:bg-white/25" aria-label="Все разделы">
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true"><path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </summary>
        <nav aria-label="Основное меню" class="card absolute right-0 mt-3 w-[min(88vw,320px)] p-6 text-ink">
          <ul class="grid gap-3 text-[0.95rem] font-medium">
            {nav.map((i) => <li><a class="hover:text-mint-dark" href={link(i.href)}>{i.label}</a></li>)}
          </ul>
          <a href={site.phoneHref} class="mt-5 block font-display">{site.phone}</a>
          <a href={site.booking} class="btn-mint mt-4 w-full">Проверить даты</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header:not([data-top]) {
    background: rgb(255 255 255 / 0.96);
    color: var(--color-ink);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.06);
    backdrop-filter: blur(12px);
  }
  .site-header:not([data-top]) .logo-white {
    opacity: 0;
  }
  .site-header:not([data-top]) .logo-dark {
    opacity: 1;
  }
</style>

<script>
  const init = () => {
    const h = document.querySelector<HTMLElement>('.site-header');
    const menu = document.querySelector<HTMLDetailsElement>('details.menu');
    if (menu) menu.open = false;
    // На страницах без тёмного первого экрана шапка сразу белая
    const dark = !!document.querySelector('[data-hero-dark]');
    const on = () => h?.toggleAttribute('data-top', dark && window.scrollY < 40);
    on();
    addEventListener('scroll', on, { passive: true });
    document.addEventListener('click', (e) => {
      if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  };
  document.addEventListener('astro:page-load', init);
</script>
