---
import { faq } from '../data/faq';

// Две колонки аккордеонов как на текущем сайте; ответы в HTML (details) — видны поисковикам, есть FAQPage в JSON-LD страницы
const half = Math.ceil(faq.length / 2);
const columns = [faq.slice(0, half), faq.slice(half)];
---

<section id="faq" class="py-16 sm:py-24" aria-labelledby="faq-title" data-reveal>
  <div class="wrap">
    <p class="eyebrow text-center">Перед поездкой</p>
    <h2 id="faq-title" class="h-section mx-auto mt-3 max-w-3xl text-center">Часто задаваемые вопросы</h2>
    <div class="mt-10 grid gap-x-12 md:grid-cols-2">
      {
        columns.map((col) => (
          <div>
            {col.map((f) => (
              <details class="group border-b border-line">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-display text-[0.82rem] uppercase sm:text-sm">
                  <span>{f.q}</span>
                  <span class="text-2xl leading-none font-light transition group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="pb-5 text-[0.95rem] leading-relaxed whitespace-pre-line text-muted">{f.a}</p>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
