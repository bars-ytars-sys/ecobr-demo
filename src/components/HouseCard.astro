---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { link, rub } from '../data/site';

interface Props {
  house: CollectionEntry<'houses'>;
  headingLevel?: 'h2' | 'h3';
}
const { house, headingLevel = 'h3' } = Astro.props;
const h = house.data;
const Heading = headingLevel;
---

<article class="card group flex h-full flex-col overflow-hidden">
  <a href={link(`/doma/${house.id}`)} class="relative block overflow-hidden" tabindex="-1" aria-hidden="true">
    <Picture
      formats={['avif', 'webp']}
      src={h.cover}
      alt=""
      widths={[360, 540, 720]}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw"
      class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-105"
    />
    {h.badge && <span class="chip absolute top-3 left-3 text-[0.6rem]!">{h.badge}</span>}
  </a>
  <div class="flex flex-1 flex-col p-5">
    <p class="w-fit rounded-[6px] bg-highlight/70 px-2 py-0.5 text-xs font-semibold">{h.tagline}</p>
    <Heading class="mt-3 text-xl">
      <a href={link(`/doma/${house.id}`)} class="hover:text-mint-dark">{h.name}</a>
    </Heading>
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
      <li>до {h.capacity} гостей</li>
      {h.chan && <li>банный чан</li>}
      {h.banya && <li>баня</li>}
    </ul>
    <p class="mt-4 font-display text-lg">от <span class="mark">{rub(h.price.weekday)}</span> <span class="font-sans text-xs text-muted normal-case">/ сутки</span></p>
    <a href={link(`/doma/${house.id}`)} class="btn-outline mt-5 w-full">Подробнее о доме</a>
  </div>
</article>
