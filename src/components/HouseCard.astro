---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { link, rub } from '../data/site';

interface Props {
  house: CollectionEntry<'houses'>;
  size?: 'lg' | 'md';
  delay?: number;
}
const { house, size = 'md', delay = 0 } = Astro.props;
const h = house.data;
const href = link(`/doma/${house.id}`);
---

{/* Карточка в стиле «проектов» открытьбазу.рф: большое фото, счётчик кадров, цена */}
<article class="card group relative flex h-full flex-col overflow-hidden" data-reveal style={`--d:${delay}`}>
  <div class:list={['relative overflow-hidden', size === 'lg' && 'lg:flex-1']}>
    <Picture
      formats={['avif', 'webp']}
      src={h.cover}
      alt={`${h.name} — дом в Берёзовой роще`}
      widths={size === 'lg' ? [480, 760, 1100] : [360, 540, 760]}
      sizes={size === 'lg' ? '(min-width: 1024px) 60vw, 94vw' : '(min-width: 1024px) 380px, (min-width: 640px) 46vw, 94vw'}
      class:list={['w-full object-cover transition duration-[1200ms] ease-[var(--ease-out)] group-hover:scale-[1.06]', size === 'lg' ? 'aspect-[16/10] lg:aspect-auto lg:h-full' : 'aspect-[4/3]']}
      transition:name={`cover-${house.id}`}
    />
    {h.badge && <span class="glass absolute top-3 left-3 rounded-full px-3 py-1.5 text-[0.68rem] font-semibold">{h.badge}</span>}
    <span class="glass-dark absolute right-3 bottom-3 rounded-full px-3 py-1.5 text-[0.7rem]">{h.gallery.length} кадров ↗</span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class:list={['leading-tight', size === 'lg' ? 'text-2xl sm:text-3xl' : 'text-lg']}>
      <a href={href} class="after:absolute after:inset-0">{h.name}</a>
    </h3>
    <p class="mt-1 text-sm font-semibold text-teal">{h.tagline}</p>
    <p class="mt-3 line-clamp-3 text-sm text-muted">{h.lead}</p>
    <div class="mt-auto flex items-end justify-between gap-3 pt-5">
      <p class="text-sm text-muted">до {h.capacity} гостей{h.banya ? ' · баня' : ''} · чан</p>
      <p class="font-display text-lg whitespace-nowrap">от {rub(h.price.weekday)}</p>
    </div>
  </div>
</article>
