---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  name: string;
}
const { images, name } = Astro.props;
// Полноразмерные версии для просмотра грузятся только по клику
const full = await Promise.all(images.map((src) => getImage({ src, width: 2200, format: 'webp' })));
---

{/* Журнальная раскладка: колонки с естественными пропорциями кадров, без обрезки */}
<div class="gallery">
  <ul class="columns-2 gap-3 sm:gap-5 lg:columns-3">
    {
      images.map((src, i) => (
        <li class="mb-3 break-inside-avoid sm:mb-5">
          <button type="button" data-index={i} class="group block w-full cursor-zoom-in overflow-hidden" aria-label={`Открыть фото ${i + 1} из ${images.length}`}>
            <Picture
              formats={['avif', 'webp']}
              src={src}
              alt={`${name}: фото ${i + 1}`}
              widths={[320, 480, 720]}
              sizes="(min-width: 1024px) 30vw, 48vw"
              class="w-full transition duration-[1200ms] ease-[var(--ease-soft)] group-hover:scale-[1.03]"
            />
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="m-0 h-dvh max-h-none w-screen max-w-none bg-night/97 p-0 text-cream backdrop:bg-night/90" data-full={JSON.stringify(full.map((f) => f.src))}>
    <div class="flex h-full flex-col">
      <div class="wrap flex items-center justify-between py-5">
        <span class="counter label text-stone"></span>
        <button type="button" class="close btn-line px-5! py-3!">Закрыть</button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-20">
        <img class="max-h-full max-w-full object-contain" alt="" decoding="async" />
        <button type="button" class="prev absolute top-1/2 left-4 hidden size-14 -translate-y-1/2 text-3xl ring-1 ring-cream/25 sm:block" aria-label="Предыдущее фото">←</button>
        <button type="button" class="next absolute top-1/2 right-4 hidden size-14 -translate-y-1/2 text-3xl ring-1 ring-cream/25 sm:block" aria-label="Следующее фото">→</button>
      </div>
      <p class="py-5 text-center text-xs text-stone">Листайте свайпом или стрелками</p>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((g) => {
    const dlg = g.querySelector<HTMLDialogElement>('dialog')!;
    const img = dlg.querySelector('img')!;
    const counter = dlg.querySelector('.counter')!;
    const srcs: string[] = JSON.parse(dlg.dataset['full'] ?? '[]');
    let idx = 0;
    const show = (i: number) => {
      idx = (i + srcs.length) % srcs.length;
      img.src = srcs[idx] ?? '';
      counter.textContent = `${idx + 1} / ${srcs.length}`;
    };
    g.querySelectorAll<HTMLButtonElement>('button[data-index]').forEach((b) =>
      b.addEventListener('click', () => {
        show(Number(b.dataset['index']));
        dlg.showModal();
      }),
    );
    dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.next')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(idx + 1);
      if (e.key === 'ArrowLeft') show(idx - 1);
    });
    let x0 = 0;
    dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0]?.clientX ?? 0), { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = (e.changedTouches[0]?.clientX ?? 0) - x0;
      if (Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1));
    });
  });
</script>
