---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Scroller from './Scroller.astro';

interface Props {
  images: ImageMetadata[];
  name: string;
}
const { images, name } = Astro.props;
// Полноразмерные версии для просмотра грузятся только по клику
const full = await Promise.all(images.map((src) => getImage({ src, width: 1800, format: 'webp' })));
---

{/* Карусель фото как на текущем сайте + просмотр во весь экран */}
<div class="gallery">
  <Scroller label={`Фотографии дома ${name}`} class="-mx-4 sm:-mx-6">
    {
      images.map((src, i) => (
        <button type="button" data-index={i} class="block w-[82%] shrink-0 snap-center overflow-hidden rounded-[16px] sm:w-[46%] lg:w-[32%]" aria-label={`Открыть фото ${i + 1} из ${images.length}`}>
          <Picture
            formats={['avif', 'webp']}
            src={src}
            alt={`${name}: фото ${i + 1}`}
            widths={[360, 540, 720]}
            sizes="(min-width: 1024px) 380px, 82vw"
            class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-105"
            loading={i < 2 ? 'eager' : 'lazy'}
          />
        </button>
      ))
    }
  </Scroller>

  <dialog class="m-auto h-dvh max-h-none w-screen max-w-none bg-black/92 p-0 text-white backdrop:bg-black/80" data-full={JSON.stringify(full.map((f) => f.src))}>
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between px-4 py-4">
        <span class="counter text-sm"></span>
        <button type="button" class="close btn-mint px-4! py-2.5!">Закрыть</button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-16">
        <img class="max-h-full max-w-full rounded-lg object-contain" alt="" decoding="async" />
        <button type="button" class="prev absolute top-1/2 left-3 hidden size-12 -translate-y-1/2 place-items-center rounded-full bg-mint text-[#0b3b2c] sm:grid" aria-label="Предыдущее фото">‹</button>
        <button type="button" class="next absolute top-1/2 right-3 hidden size-12 -translate-y-1/2 place-items-center rounded-full bg-mint text-[#0b3b2c] sm:grid" aria-label="Следующее фото">›</button>
      </div>
      <p class="py-4 text-center text-xs text-white/60">Листайте свайпом или стрелками</p>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((g) => {
    const dlg = g.querySelector<HTMLDialogElement>('dialog')!;
    const img = dlg.querySelector('img')!;
    const counter = dlg.querySelector('.counter')!;
    const srcs: string[] = JSON.parse(dlg.dataset['full'] ?? '[]');
    let idx = 0;
    const show = (i: number) => {
      idx = (i + srcs.length) % srcs.length;
      img.src = srcs[idx] ?? '';
      counter.textContent = `${idx + 1} / ${srcs.length}`;
    };
    g.querySelectorAll<HTMLButtonElement>('button[data-index]').forEach((b) =>
      b.addEventListener('click', () => {
        show(Number(b.dataset['index']));
        dlg.showModal();
      }),
    );
    dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.next')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(idx + 1);
      if (e.key === 'ArrowLeft') show(idx - 1);
    });
    let x0 = 0;
    dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0]?.clientX ?? 0), { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = (e.changedTouches[0]?.clientX ?? 0) - x0;
      if (Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1));
    });
  });
</script>
