---
import { link, site } from '../data/site';

interface Props {
  items: { href: string; label: string }[];
}
const { items } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: `${site.url}${c.href}` })),
};
---

<nav aria-label="Хлебные крошки" class="text-sm">
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-2">
          {i < items.length - 1 ? <a class="text-ink hover:text-mint-dark" href={link(c.href)}>{c.label}</a> : <span aria-current="page" class="text-mint-dark">{c.label}</span>}
          {i < items.length - 1 && <span class="text-muted" aria-hidden="true">»</span>}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
