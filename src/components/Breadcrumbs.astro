---
import { link, site } from '../data/site';

interface Props {
  items: { href: string; label: string }[];
}
const { items } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: `${site.url}${c.href}` })),
};
---

<nav aria-label="Хлебные крошки" class="label text-[0.62rem] text-cream/70">
  <ol class="flex flex-wrap items-center gap-3">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-3">
          {i < items.length - 1 ? <a class="link-line hover:text-cream" href={link(c.href)}>{c.label}</a> : <span aria-current="page" class="text-cream">{c.label}</span>}
          {i < items.length - 1 && <span aria-hidden="true">—</span>}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
