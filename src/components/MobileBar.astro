---
import { site } from '../data/site';
---

{/* На мобильном путь к брони всегда в один тап */}
<div class="fixed inset-x-0 bottom-0 z-50 border-t border-moss bg-night/92 pb-[env(safe-area-inset-bottom)] backdrop-blur-md sm:hidden">
  <div class="grid grid-cols-[1fr_1fr_1.6fr] text-[0.7rem] font-semibold tracking-[0.16em] uppercase">
    <a href={site.phoneHref} class="flex items-center justify-center py-4">Звонок</a>
    <a href={site.telegram} class="flex items-center justify-center border-l border-moss py-4" rel="noopener" target="_blank">Telegram</a>
    <a href={site.booking} class="flex items-center justify-center bg-brass py-4 text-night">Даты и цены</a>
  </div>
</div>
