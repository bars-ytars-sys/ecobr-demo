---
import logo from '../assets/v2/brand/brand-02.svg';
import { link, site } from '../data/site';

const cols = [
  [
    { href: '/special', label: 'Специальные предложения' },
    { href: '/about', label: 'О базе' },
    { href: '/doma', label: 'Каталог домов' },
    { href: '/aktivnosti-v-beryozovoj-roshhe', label: 'Активности' },
    { href: '/vip-programmy', label: 'VIP-программы' },
  ],
  [
    { href: '/deti', label: 'Отдых с детьми' },
    { href: '/spa', label: 'SPA и релакс' },
    { href: '/kartabr', label: 'Карта территории' },
    { href: '/contacts', label: 'Контакты' },
  ],
];
---

<footer id="kontakty" class="pb-6">
  <div class="wrap">
    {/* Контакты — как на текущем сайте */}
    <section class="card relative overflow-hidden px-6 py-12 sm:px-12 sm:py-16" aria-labelledby="contacts-title">
      <div class="pointer-events-none absolute -top-24 right-0 size-96 rounded-full bg-mint/25 blur-3xl"></div>
      <h2 id="contacts-title" class="h-section relative text-center">Ваше личное пространство <br class="hidden sm:block" />восстановления</h2>
      <div class="relative mt-10 grid gap-10 md:grid-cols-2">
        <address class="not-italic">
          <p class="font-display text-lg uppercase">Адрес</p>
          <p class="mt-3 max-w-md leading-relaxed">{site.address} Экобаза «Берёзовая роща»</p>
          <p class="mt-4 flex gap-5 font-display text-sm uppercase underline underline-offset-4">
            <a href={site.yandexMaps} target="_blank" rel="noopener">Яндекс Карты</a>
            <a href="https://2gis.ru/moscow/search/%D0%91%D0%B5%D1%80%D1%91%D0%B7%D0%BE%D0%B2%D0%B0%D1%8F%20%D1%80%D0%BE%D1%89%D0%B0" target="_blank" rel="noopener">2ГИС</a>
          </p>
        </address>
        <div>
          <p class="text-muted">Отдел бронирования</p>
          <a href={site.phoneHref} class="mt-1 block font-display text-3xl">{site.phone}</a>
          <p class="mt-1 text-sm text-muted">{site.hours}</p>
          <a href={`${link('/')}#lead`} class="btn-outline mt-6">Обратный звонок</a>
        </div>
      </div>
    </section>

    <div class="mt-10 grid gap-8 px-2 text-sm sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr_1fr]">
      <div>
        <img src={logo.src} width="150" height="55" alt="Берёзовая роща" class="h-12 w-auto" loading="lazy" />
        <p class="mt-4 text-xs text-muted">ИП Резниченко В.Ю. · ИНН 502016199950</p>
        <p class="mt-2 text-xs text-muted">Договор оферты · Политика конфиденциальности</p>
      </div>
      {
        cols.map((c) => (
          <ul class="space-y-2.5">
            {c.map((i) => (
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-mint" aria-hidden="true" />
                <a class="hover:text-mint-dark" href={link(i.href)}>{i.label}</a>
              </li>
            ))}
          </ul>
        ))
      }
      <p class="text-xs text-muted">Предложения о сотрудничестве направляйте на <a class="text-mint-dark underline" href={`mailto:${site.email}`}>электронную почту</a></p>
    </div>
    <p class="mt-8 px-2 text-center text-xs text-muted">Демо нового сайта на Astro · закрыто от индексации</p>
  </div>
</footer>
