---
import { link, nav, site } from '../data/site';

const channels = [
  { label: 'Telegram', note: 't.me/ecobazabr', href: site.telegram },
  { label: 'Яндекс Карты', note: 'маршрут и отзывы', href: site.yandexMaps },
  { label: 'Позвонить', note: site.phone, href: site.phoneHref },
];
---

<section class="wrap py-16 sm:py-24" aria-labelledby="channels-title" data-reveal>
  <p class="eyebrow">Мы на связи</p>
  <h2 id="channels-title" class="h-section mt-3">Где нас найти и спросить</h2>
  <div class="mt-8 grid gap-3 sm:grid-cols-3">
    {
      channels.map((c) => (
        <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="card group flex items-center justify-between gap-4 p-5 transition hover:-translate-y-1">
          <span>
            <span class="flex items-center gap-2 font-display text-sm uppercase"><span class="dot text-mint" />{c.label}</span>
            <span class="mt-1 block text-sm text-muted">{c.note}</span>
          </span>
          <span class="text-xl transition group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
</section>

<footer id="kontakty" class="overflow-hidden bg-night text-white">
  <div class="wrap grid gap-10 pt-14 pb-8 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <p class="font-display text-xl uppercase">Берёзовая роща</p>
      <address class="mt-4 max-w-sm text-sm leading-relaxed text-white/70 not-italic">{site.address}</address>
      <a href={site.phoneHref} class="mt-5 block font-display text-2xl">{site.phone}</a>
      <p class="mt-1 text-sm text-white/60">{site.hours}</p>
    </div>
    <nav aria-label="Разделы сайта">
      <ul class="grid gap-2.5 text-sm text-white/80">
        {nav.slice(0, 5).map((i) => <li><a class="hover:text-mint" href={link(i.href)}>{i.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <ul class="grid gap-2.5 text-sm text-white/80">
        {nav.slice(5).map((i) => <li><a class="hover:text-mint" href={link(i.href)}>{i.label}</a></li>)}
      </ul>
      <p class="mt-6 text-xs text-white/50">ИП Резниченко В.Ю. · ИНН 502016199950</p>
      <p class="mt-1 text-xs text-white/50">Сотрудничество: <a class="underline" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </div>
  {/* Огромная надпись-подпись, как на открытьбазу.рф */}
  <p class="pointer-events-none -mb-[0.18em] text-center font-display text-[13.5vw] leading-none whitespace-nowrap text-white/10 uppercase select-none" aria-hidden="true">Берёзовая роща</p>
</footer>
